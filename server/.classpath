	<classpathentry kind="con" path="org.eclipse.jdt.junit.JUNIT_CONTAINER/4"/>
	<classpathentry combineaccessrules="false" kind="src" path="/com.oracle.truffle.api.exception"/>
	<classpathentry combineaccessrules="false" kind="src" path="/SOMns"/>
	<classpathentry combineaccessrules="false" kind="src" path="/TruffleSOM"/>
