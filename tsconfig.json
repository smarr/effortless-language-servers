{
	"compilerOptions": {
		"target": "es2023",
		"module": "node20",
		"outDir": "out",
		"lib": ["ES2023"],
		"strict": true,
		"skipLibCheck": true,
		"sourceMap": true
	},
  "include": [
    "test/**/*",
    "src/**/*"
  ],
	"exclude": [
		"node_modules",
		".vscode-test",
		".vscode",
		"server"
	]
}
